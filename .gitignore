# ---- Added 2026-07-24 (v10.3.1 full-mirror sync) ----
# Operational/session state. The DIRECTORIES are part of the system and are
# documented in RUNTIME-STATE.md; only the per-session CONTENTS are private.
# Schema/format templates are re-included so adopters can populate their own.
atlas-kg/*
!atlas-kg/SCHEMA.md
proposals/*
!proposals/TEMPLATE.md
atlas-action-graph/
tasks/
teams/
context-mode/
# MCP servers: ship the source, never the vendored dependency trees.
mcp-servers/**/node_modules/
# Archived brain-consolidation tarballs (personal knowledge snapshots).
_archived/
# Plugin runtime state — machine-specific paths and install counts.
plugins/.install-manifests
plugins/.last_inuse_sweep
plugins/data/
# Personal-identity skills: real name, school, course codes, personal voice.
skills/*-style/
skills/*-style-*/
# Hook written for a personal project.
hooks/_archived/*-ship-guard.js
